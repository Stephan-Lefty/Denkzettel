[Desktop Entry]
Type=Application
Version=1.0
Name=Denkzettel: Gedanken aufnehmen
GenericName=Sprachnotiz aufnehmen
Comment=Nimmt sofort auf - sprechen, prüfen, gespeichert
Comment[en]=Starts recording right away - speak, check, saved
Exec=denkzettel erfassen
Icon=denkzettel
Terminal=false
Categories=Utility;
StartupNotify=true
StartupWMClass=denkzettel
# Diese Datei ist KEIN zweiter Menüeintrag, sondern nur der Träger für das
# globale Tastenkürzel unter Plasma - deshalb NoDisplay. Im Menü steht
# Denkzettel einmal, und „Gedanken aufnehmen“ hängt dort als Aktion an
# (Rechtsklick auf den Eintrag). GNOME bekommt sein Kürzel über gsettings,
# siehe install.sh.
NoDisplay=true
X-KDE-Shortcuts=@TASTE@
